; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Color"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"
SceneManager="*res://scripts/scene_manager.gd"
HeightMap="*res://scripts/height_map.gd"
DialogueManager="*uid://c3rodes2l3gxb"
PhantomCameraManager="*uid://duq6jhf6unyis"
AudioManager="*res://scripts/audio_manager.gd"
StoryDirector="*res://scripts/story_director.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[dialogue_manager]

runtime/balloon_path="res://dialogue/balloon.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Color"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogue/player.dialogue", "res://dialogue/dia/companion.dialogue", "res://dialogue/dia/story_template.dialogue", "res://dialogue/dia/prologue.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
